{
    "lsp": {
        "rust-analyzer": {
            "initialization_options": {
                "checkOnSave": true,
                "check": { "command": "clippy" },
                "files": {
                    "exclude": ["**/target/**", "**/.temp/**"]
                },
                "linkedProjects": [
                    ".run/Cargo.toml",
                    "mingling_ci/Cargo.toml",
                    "mingling_pathf/test/Cargo.toml",
                    "arg_picker/Cargo.toml",
                    "arg_picker/test/Cargo.toml",
                    "mingling_cli/Cargo.toml"
                ],
                "cargo": {
                    "features": []
                },
                "procMacro": {
                    "enable": true,
                    "attributes": {
                        "enable": true
                    }
                }
            }
        }
    }
}
